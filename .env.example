# Configuration template. Copy to .env and fill in values locally.
# Never commit .env or put real keys, secrets or IDs in this file.

# --- AI and places APIs (required) ---
# Gemini API key (the Google GenAI SDK also accepts GOOGLE_API_KEY).
GEMINI_API_KEY=
GEOAPIFY_API_KEY=

# --- Development switches ---
# MOCK_LLM=true: travel RAG answers without calling Gemini.
MOCK_LLM=
# Not currently read by the application; kept for compatibility.
MOCK_PLACES=

# --- Optional (defaults shown) ---
# DATABASE_PATH=app.db
# UPLOADS_VECTORSTORE_DIR=vectorstore_uploads
# API_URL=http://127.0.0.1:8000/ask
# ASK_TIMEOUT=180

# --- Plan limits (optional; defaults in services/plans.py) ---
# GUEST_MESSAGE_LIMIT=5
# FREE_MESSAGE_LIMIT=50
# PRO_MESSAGE_LIMIT=1000
# GUEST_DOCUMENT_LIMIT=5
# FREE_DOCUMENT_LIMIT=10
# PRO_DOCUMENT_LIMIT=200
# Optional display text for prices.
# FREE_PLAN_PRICE=Free
# PRO_PLAN_PRICE=

# --- Pro pricing (required for upgrades) ---
# Amount in the smallest currency unit: 49900 paise = INR 499.00.
PRO_PRICE_AMOUNT=49900
PRO_PRICE_CURRENCY=INR
# daily | weekly | monthly | quarterly | yearly
PRO_BILLING_PERIOD=monthly
PRO_BILLING_INTERVAL=1
# Number of billing cycles per subscription.
PRO_BILLING_CYCLES=12

# --- Payments: Razorpay TEST MODE ONLY (backend only) ---
# Test key IDs start with rzp_test_; live keys are refused.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Test-mode plan ID for Pro (plan_...). Must match the Pro pricing above.
RAZORPAY_PRO_PLAN_ID=
# Secret you set on the Razorpay webhook (POST /billing/webhook).
RAZORPAY_WEBHOOK_SECRET=
